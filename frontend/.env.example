# Optional. By default the app calls the relative /api path, which the Vite
# dev server proxies to http://localhost:3001 (see vite.config.js) and which
# vercel.json rewrites to the backend service in production. Only set this if
# the backend is hosted on a different origin than the frontend.
# VITE_API_URL=https://your-backend.example.com/api
